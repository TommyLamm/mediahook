# ── 必填 ───────────────────────────────────────────
# API 金鑰，捷徑會用它呼叫服務。產生方式：openssl rand -hex 32
MEDIAHOOK_API_KEY=

# 對外網址，用來產生下載連結
MEDIAHOOK_PUBLIC_URL=https://dl.gyke.net

# ── 選填（以下皆為預設值）───────────────────────────
# 下載好的檔案保留幾小時
# MEDIAHOOK_FILE_TTL_HOURS=6
# 下載連結幾秒後失效
# MEDIAHOOK_LINK_TTL_SECONDS=3600
# 同時執行的下載數、最多排隊數
# MEDIAHOOK_MAX_CONCURRENT_JOBS=2
# MEDIAHOOK_MAX_PENDING_JOBS=20
# 單一任務最長執行秒數
# MEDIAHOOK_JOB_TIMEOUT_SECONDS=600
# 單檔大小上限（MB）、單則貼文最多抓幾個檔案
# MEDIAHOOK_MAX_FILE_MB=1024
# MEDIAHOOK_MAX_ITEMS=30
# 同一平台兩個任務之間至少間隔幾秒
# MEDIAHOOK_PLATFORM_MIN_INTERVAL=2

# ── Proxy ─────────────────────────────────────────
# 所有平台共用的 proxy（支援 http:// 與 socks5://）
# MEDIAHOOK_PROXY=
# 個別平台的 proxy，會覆寫共用值。例如讓抖音、小紅書走亞洲出口：
# MEDIAHOOK_PROXY_DOUYIN=socks5://100.64.0.2:1080
# MEDIAHOOK_PROXY_XIAOHONGSHU=socks5://100.64.0.2:1080
# 可用的平台名稱：INSTAGRAM THREADS TIKTOK DOUYIN XIAOHONGSHU TWITTER FACEBOOK
